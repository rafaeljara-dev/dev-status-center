<Window x:Class="DevStatusCenter.Desktop.Views.ProviderSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Providers &amp; credentials"
        Width="720"
        Height="470"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        ShowInTaskbar="True">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <TextBlock Grid.ColumnSpan="2"
               Text="PROVIDERS &amp; CREDENTIALS"
               Style="{StaticResource SectionLabel}" />

    <ListBox x:Name="ProvidersList"
             Grid.Row="1"
             Margin="0,0,14,0"
             Background="{StaticResource SurfaceRaisedBrush}"
             BorderBrush="{StaticResource BorderBrush}"
             Foreground="{StaticResource TextBrush}"
             SelectionChanged="ProvidersList_SelectionChanged">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="2,5">
            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding StatusLine}"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="10"
                       Margin="0,2,0,0" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel Grid.Row="1" Grid.Column="1">
      <CheckBox x:Name="EnabledBox"
                Content="Refrescar este provider"
                Foreground="{StaticResource TextBrush}"
                Margin="0,0,0,12" />

      <TextBlock Text="Credential reference" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
      <TextBox x:Name="ReferenceBox" Margin="0,4,0,10" Padding="6,4" />

      <TextBlock Text="Account ID (opcional)" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
      <TextBox x:Name="AccountBox" Margin="0,4,0,10" Padding="6,4" />

      <TextBlock Text="Token de solo lectura" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
      <PasswordBox x:Name="TokenBox" Margin="0,4,0,6" Padding="6,4" />
      <TextBlock TextWrapping="Wrap"
                 Foreground="#74839A"
                 FontSize="10"
                 Text="El token se cifra con DPAPI bajo tu cuenta de Windows y se guarda fuera de la base de datos. Nunca se muestra de vuelta: para cambiarlo, pega uno nuevo." />

      <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
        <Button Content="Guardar token" Padding="12,6" Click="SaveToken_Click" />
        <Button Content="Borrar token" Padding="12,6" Margin="8,0,0,0" Click="DeleteToken_Click" />
        <Button Content="Guardar ajustes" Padding="12,6" Margin="8,0,0,0" Click="SaveSettings_Click" />
      </StackPanel>
    </StackPanel>

    <TextBlock x:Name="MessageText"
               Grid.Row="2"
               Grid.ColumnSpan="2"
               Margin="0,14,0,0"
               TextWrapping="Wrap"
               Foreground="{StaticResource MutedTextBrush}"
               FontSize="11" />
  </Grid>
</Window>
