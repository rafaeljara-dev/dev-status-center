<Window x:Class="DevStatusCenter.Desktop.Views.QuickAccessManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Access"
        Width="620"
        Height="500"
        MinWidth="560"
        MinHeight="430"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}">
  <Grid Margin="18">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230" />
      <ColumnDefinition Width="18" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="PINNED ITEMS" Style="{StaticResource SectionLabel}" />
      <Button DockPanel.Dock="Bottom" Click="Delete_Click" Margin="0,10,0,0" Content="Delete selected" />
      <ListBox x:Name="EntriesList"
               DisplayMemberPath="DisplayName"
               SelectionChanged="EntriesList_SelectionChanged"
               Background="{StaticResource SurfaceRaisedBrush}"
               Foreground="{StaticResource TextBrush}"
               BorderBrush="{StaticResource BorderBrush}" />
    </DockPanel>

    <StackPanel Grid.Column="2">
      <TextBlock Text="ADD OR EDIT" Style="{StaticResource SectionLabel}" />
      <TextBlock Text="Name" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
      <TextBox x:Name="NameBox" Margin="0,5,0,12" Padding="7" />

      <TextBlock Text="Type" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
      <ComboBox x:Name="KindBox" Margin="0,5,0,12" Padding="7" SelectionChanged="KindBox_SelectionChanged" />

      <TextBlock Text="Parent group (optional)" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
      <ComboBox x:Name="ParentBox"
                Margin="0,5,0,12"
                Padding="7"
                DisplayMemberPath="DisplayName"
                SelectedValuePath="Id" />

      <TextBlock Text="Folder path" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
      <Grid Margin="0,5,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="PathBox" Padding="7" />
        <Button x:Name="BrowseButton" Grid.Column="1" Click="Browse_Click" Content="Browse…" Margin="8,0,0,0" />
      </Grid>

      <TextBlock Text="Default action" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
      <ComboBox x:Name="ActionBox" Margin="0,5,0,18" Padding="7" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Click="New_Click" Content="New" Margin="0,0,8,0" />
        <Button Click="Save_Click" Content="Save item" />
      </StackPanel>
      <TextBlock x:Name="MessageText"
                 Foreground="{StaticResource MutedTextBrush}"
                 FontSize="10"
                 TextWrapping="Wrap"
                 Margin="0,14,0,0" />
    </StackPanel>
  </Grid>
</Window>

