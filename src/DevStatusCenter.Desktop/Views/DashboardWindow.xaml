<Window x:Class="DevStatusCenter.Desktop.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DevStatusCenter.Desktop.Controls"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Dev Status Center"
        Width="440"
        Height="740"
        MinHeight="460"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource TextBrush}"
        KeyDown="Window_KeyDown"
        Deactivated="Window_Deactivated">
  <!--
    Sin AllowsTransparency: esa bandera es incompatible con los backdrops del DWM, y sin backdrop
    no hay cristal. Las esquinas redondeadas las pide WindowBackdrop al propio Windows.
  -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Línea de estado. Monoespaciada y en una sola fila: se lee de un vistazo, sin leer nada. -->
    <StackPanel Orientation="Horizontal" Margin="18,15,18,0">
      <Ellipse Width="5" Height="5" VerticalAlignment="Center" Margin="0,0,8,0">
        <Ellipse.Fill>
          <SolidColorBrush Color="{Binding StatusColor}" />
        </Ellipse.Fill>
      </Ellipse>
      <TextBlock Text="{Binding MonitoringLabel}"
                 Style="{StaticResource MonoLabel}"
                 Foreground="{StaticResource MutedTextBrush}" />
      <TextBlock Text="·" Style="{StaticResource MonoLabel}" Margin="7,0" />
      <TextBlock Text="{Binding SyncBadge}" Style="{StaticResource MonoLabel}" />
      <TextBlock Text="·" Style="{StaticResource MonoLabel}" Margin="7,0" />
      <TextBlock Text="{Binding ServiceBadge}" Style="{StaticResource MonoLabel}" />
      <TextBlock Text="{Binding AlertBadge}"
                 Style="{StaticResource MonoLabel}"
                 Foreground="{StaticResource WarningBrush}"
                 Margin="12,0,0,0"
                 Visibility="{Binding HasAlert, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </StackPanel>

    <!-- Encabezado de consola: la cifra del mes, la proyección y el medidor de presupuesto. -->
    <StackPanel Grid.Row="1" Margin="18,14,18,0">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="THIS MONTH ·" Style="{StaticResource SectionLabel}" FontSize="11" Margin="0" />
        <TextBlock Text="{Binding CurrencyLabel}" Style="{StaticResource SectionLabel}" FontSize="11" Margin="4,0,0,0" />
      </StackPanel>
      <Grid Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding CurrentAmount}"
                   Style="{StaticResource Numeric}"
                   FontSize="46"
                   VerticalAlignment="Bottom" />
        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,5">
          <TextBlock Text="PROJECTED" Style="{StaticResource SectionLabel}" FontSize="11" Margin="0,0,0,4" HorizontalAlignment="Right" />
          <TextBlock Text="{Binding ProjectedAmount}"
                     Style="{StaticResource Numeric}"
                     FontSize="19"
                     Foreground="{StaticResource AccentBrush}"
                     HorizontalAlignment="Right" />
        </StackPanel>
      </Grid>

      <ItemsControl ItemsSource="{Binding BudgetMeter}" Margin="0,16,0,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <primitives:UniformGrid Rows="1" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Height="9"
                    Margin="0,0,3,0"
                    CornerRadius="1"
                    Background="{Binding Fill}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Grid Margin="0,8,0,0">
        <TextBlock Text="{Binding BudgetText}" Style="{StaticResource MonoLabel}" />
        <TextBlock Text="{Binding BudgetLimit}" Style="{StaticResource MonoLabel}" HorizontalAlignment="Right" />
      </Grid>
    </StackPanel>

    <!-- Pestañas. La primera es la mascota; las teclas 1-4 hacen lo mismo que el clic. -->
    <Border Grid.Row="2" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Margin="18,20,18,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Button Style="{StaticResource FlatButton}"
                Command="{Binding SelectTabCommand}"
                CommandParameter="0"
                ToolTip="Overview">
          <Border BorderThickness="0,0,0,2"
                  Padding="0,2,0,6"
                  Margin="0,0,0,-1"
                  BorderBrush="{Binding SelectedTab, Converter={StaticResource TabUnderline}, ConverterParameter=0}">
            <!--
              La cara del popup no se dibuja: se recibe. Es el mismo cuadro que el area de
              notificaciones esta mostrando en ese instante, solo que con celdas de 2 px.
            -->
            <controls:PixelFace x:Name="TabFace"
                                Width="34"
                                Height="34"
                                HorizontalAlignment="Center" />
          </Border>
        </Button>

        <Button Grid.Column="1"
                Style="{StaticResource FlatButton}"
                Command="{Binding SelectTabCommand}"
                CommandParameter="1">
          <Border BorderThickness="0,0,0,2"
                  Padding="0,7,0,10"
                  Margin="0,0,0,-1"
                  BorderBrush="{Binding SelectedTab, Converter={StaticResource TabUnderline}, ConverterParameter=1}">
            <TextBlock Text="AI"
                       FontSize="13"
                       FontWeight="Medium"
                       HorizontalAlignment="Center"
                       Foreground="{Binding SelectedTab, Converter={StaticResource TabForeground}, ConverterParameter=1}" />
          </Border>
        </Button>

        <Button Grid.Column="2"
                Style="{StaticResource FlatButton}"
                Command="{Binding SelectTabCommand}"
                CommandParameter="2">
          <Border BorderThickness="0,0,0,2"
                  Padding="0,7,0,10"
                  Margin="0,0,0,-1"
                  BorderBrush="{Binding SelectedTab, Converter={StaticResource TabUnderline}, ConverterParameter=2}">
            <TextBlock Text="CLOUD"
                       FontSize="13"
                       FontWeight="Medium"
                       HorizontalAlignment="Center"
                       Foreground="{Binding SelectedTab, Converter={StaticResource TabForeground}, ConverterParameter=2}" />
          </Border>
        </Button>

        <Button Grid.Column="3"
                Style="{StaticResource FlatButton}"
                Command="{Binding SelectTabCommand}"
                CommandParameter="3">
          <Border BorderThickness="0,0,0,2"
                  Padding="0,7,0,10"
                  Margin="0,0,0,-1"
                  BorderBrush="{Binding SelectedTab, Converter={StaticResource TabUnderline}, ConverterParameter=3}">
            <TextBlock Text="BILLS"
                       FontSize="13"
                       FontWeight="Medium"
                       HorizontalAlignment="Center"
                       Foreground="{Binding SelectedTab, Converter={StaticResource TabForeground}, ConverterParameter=3}" />
          </Border>
        </Button>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="3"
                  Margin="0,4,0,0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="18,10,18,10">

        <!-- 0 · Portada: en qué se va el dinero y las carpetas del día. -->
        <StackPanel Visibility="{Binding SelectedTab, Converter={StaticResource EqualityToVisibility}, ConverterParameter=0}">
          <TextBlock Text="TOP SPEND" Style="{StaticResource SectionLabel}" />
          <ItemsControl ItemsSource="{Binding TopSpend}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,13">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="27" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Path Data="{Binding Brand}"
                          Fill="{StaticResource MutedTextBrush}"
                          Width="17"
                          Height="17"
                          Stretch="Uniform"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="15" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding Amount}"
                               Style="{StaticResource Numeric}"
                               FontSize="15"
                               VerticalAlignment="Center" />
                  </Grid>
                  <Grid Margin="0,8,0,0" Height="3">
                    <Border Background="{StaticResource TrackBrush}" CornerRadius="2" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding ShareWidth}" />
                        <ColumnDefinition Width="{Binding RestWidth}" />
                      </Grid.ColumnDefinitions>
                      <Border Background="{StaticResource AccentBrush}"
                              CornerRadius="2"
                              Opacity="{Binding BarOpacity}" />
                    </Grid>
                  </Grid>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Grid Margin="0,10,0,9">
            <TextBlock Text="QUICK ACCESS" Style="{StaticResource SectionLabel}" Margin="0" />
            <Button HorizontalAlignment="Right"
                    Padding="8,3"
                    Click="ManageQuickAccess_Click">
              <TextBlock Text="Manage" FontSize="12" />
            </Button>
          </Grid>
          <ItemsControl ItemsSource="{Binding QuickAccess}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource FlatButton}"
                        Command="{Binding DataContext.OpenQuickAccessCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding IsLaunchable}"
                        HorizontalContentAlignment="Stretch"
                        Padding="6,5"
                        Margin="{Binding Indent}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="22" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Glyph}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Name}" FontSize="14" />
                      <TextBlock Text="{Binding Subtitle}"
                                 Foreground="{StaticResource FaintTextBrush}"
                                 FontSize="11"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- 1 · IA -->
        <StackPanel Visibility="{Binding SelectedTab, Converter={StaticResource EqualityToVisibility}, ConverterParameter=1}">
          <TextBlock Text="AI SERVICES" Style="{StaticResource SectionLabel}" />
          <ItemsControl ItemsSource="{Binding AiServices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,11" Margin="0,0,0,11">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="27" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Path Data="{Binding Brand}"
                          Fill="{StaticResource MutedTextBrush}"
                          Width="17"
                          Height="17"
                          Stretch="Uniform"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Margin="0,2,0,0" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Name}" FontSize="15" />
                      <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0" />
                      <TextBlock Text="{Binding Confidence}" Foreground="{StaticResource FaintTextBrush}" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               Text="{Binding Amount}"
                               Style="{StaticResource Numeric}"
                               FontSize="15"
                               VerticalAlignment="Top" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- 2 · Nube -->
        <StackPanel Visibility="{Binding SelectedTab, Converter={StaticResource EqualityToVisibility}, ConverterParameter=2}">
          <TextBlock Text="INFRASTRUCTURE" Style="{StaticResource SectionLabel}" />
          <ItemsControl ItemsSource="{Binding CloudServices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,11" Margin="0,0,0,11">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="27" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Path Data="{Binding Brand}"
                          Fill="{StaticResource MutedTextBrush}"
                          Width="17"
                          Height="17"
                          Stretch="Uniform"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Margin="0,2,0,0" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Name}" FontSize="15" />
                      <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0" />
                      <TextBlock Text="{Binding Confidence}" Foreground="{StaticResource FaintTextBrush}" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               Text="{Binding Amount}"
                               Style="{StaticResource Numeric}"
                               FontSize="15"
                               VerticalAlignment="Top" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- 3 · Pagos -->
        <StackPanel Visibility="{Binding SelectedTab, Converter={StaticResource EqualityToVisibility}, ConverterParameter=3}">
          <Border Background="{StaticResource SurfaceSoftBrush}"
                  BorderBrush="{StaticResource HairlineBrush}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="14,12"
                  Margin="0,0,0,16"
                  DataContext="{Binding NextPayment}"
                  Visibility="{Binding DataContext.NextPayment, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource NullToVisibility}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="NEXT PAYMENT" Style="{StaticResource SectionLabel}" Margin="0,0,0,5" />
                <TextBlock FontSize="15">
                  <Run Text="{Binding Name, Mode=OneWay}" />
                  <Run Text=" · " Foreground="{StaticResource FaintTextBrush}" />
                  <Run Text="{Binding Relative, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" />
                </TextBlock>
              </StackPanel>
              <TextBlock Grid.Column="1"
                         Text="{Binding Amount}"
                         Style="{StaticResource Numeric}"
                         FontSize="20"
                         VerticalAlignment="Center" />
            </Grid>
          </Border>

          <TextBlock Text="UPCOMING" Style="{StaticResource SectionLabel}" />
          <ItemsControl ItemsSource="{Binding Payments}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Date}" Style="{StaticResource MonoLabel}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2"
                             Text="{Binding Amount}"
                             Style="{StaticResource Numeric}"
                             FontSize="14"
                             VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <Border Grid.Row="4" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
      <Grid Margin="18,12,18,15">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding StatusText}"
                     Foreground="{StaticResource MutedTextBrush}"
                     FontSize="12"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding LastSync}" Style="{StaticResource MonoLabel}" FontSize="11" />
        </StackPanel>
        <Button Grid.Column="1" Command="{Binding RefreshCommand}" Padding="10,6" Margin="10,0,8,0">
          <TextBlock Text="↻ Refresh" FontSize="13" />
        </Button>
        <Button Grid.Column="2" Click="Hide_Click" Padding="10,6">
          <TextBlock Text="Close" FontSize="13" />
        </Button>
      </Grid>
    </Border>
  </Grid>
</Window>
