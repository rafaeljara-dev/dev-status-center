<Window x:Class="DevStatusCenter.Desktop.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dev Status Center"
        Width="410"
        Height="740"
        MinHeight="460"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Deactivated="Window_Deactivated">
  <Border Background="{StaticResource SurfaceBrush}"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="15"
          SnapsToDevicePixels="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Margin="18,16,18,13">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="DEV STATUS CENTER" FontWeight="Bold" FontSize="14" />
          <TextBlock Text="Personal operations at a glance"
                     Foreground="{StaticResource MutedTextBrush}"
                     FontSize="11"
                     Margin="0,3,0,0" />
        </StackPanel>
        <Button Grid.Column="1"
                Command="{Binding ToggleMonitoringCommand}"
                Padding="9,5"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="7" Height="7" Margin="0,0,6,0">
              <Ellipse.Fill>
                <SolidColorBrush Color="{Binding StatusColor}" />
              </Ellipse.Fill>
            </Ellipse>
            <TextBlock Text="{Binding MonitoringLabel}" FontSize="10" FontWeight="SemiBold" />
          </StackPanel>
        </Button>
      </Grid>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="14,0,14,8">
          <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="11" Padding="14" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="THIS MONTH" Style="{StaticResource SectionLabel}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Current" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                  <TextBlock Text="{Binding CurrentSpend}" FontSize="21" FontWeight="SemiBold" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Projected" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                  <TextBlock Text="{Binding ProjectedSpend}" FontSize="21" FontWeight="SemiBold" Margin="0,2,0,0" />
                </StackPanel>
              </Grid>
              <!-- ProgressBar.Value enlaza TwoWay por defecto y BudgetPercent es de solo
                   lectura: sin Mode=OneWay, WPF lanza al activar el binding. -->
              <ProgressBar Value="{Binding BudgetPercent, Mode=OneWay}"
                           Maximum="100"
                           Height="6"
                           Margin="0,13,0,7"
                           Background="#2A3240"
                           Foreground="{StaticResource AccentBrush}" />
              <TextBlock Text="{Binding BudgetText}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
            </StackPanel>
          </Border>

          <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="11" Padding="14" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="AI" Style="{StaticResource SectionLabel}" />
              <ItemsControl ItemsSource="{Binding AiServices}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding Confidence}" Foreground="#74839A" FontSize="9" Margin="0,2,0,0" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding Cost}" FontWeight="SemiBold" VerticalAlignment="Top" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="11" Padding="14" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="INFRASTRUCTURE" Style="{StaticResource SectionLabel}" />
              <ItemsControl ItemsSource="{Binding CloudServices}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Confidence}" Foreground="#74839A" FontSize="9" Margin="0,2,0,0" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding Cost}" FontWeight="SemiBold" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="11" Padding="14" Margin="0,0,0,10">
            <StackPanel>
              <Grid Margin="0,0,0,8">
                <TextBlock Text="QUICK ACCESS" Style="{StaticResource SectionLabel}" Margin="0" />
                <Button HorizontalAlignment="Right" Padding="7,3" Click="ManageQuickAccess_Click">
                  <TextBlock Text="Manage" FontSize="10" />
                </Button>
              </Grid>
              <ItemsControl ItemsSource="{Binding QuickAccess}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Command="{Binding DataContext.OpenQuickAccessCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"
                            CommandParameter="{Binding}"
                            IsEnabled="{Binding IsLaunchable}"
                            HorizontalContentAlignment="Stretch"
                            Padding="7,5"
                            Margin="{Binding Indent}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="22" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Glyph}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11" />
                          <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedTextBrush}" FontSize="9" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="11" Padding="14">
            <StackPanel>
              <TextBlock Text="UPCOMING PAYMENTS" Style="{StaticResource SectionLabel}" />
              <ItemsControl ItemsSource="{Binding Payments}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,7">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Date}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="2" Text="{Binding Amount}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Grid Grid.Row="2" Margin="14,10,14,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Command="{Binding RefreshCommand}" Padding="10,6">
          <TextBlock Text="↻ Refresh" FontSize="11" />
        </Button>
        <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding LastSync}" Foreground="#6F7D91" FontSize="9" />
        </StackPanel>
        <Button Grid.Column="2" Click="Hide_Click" Padding="10,6">
          <TextBlock Text="Close" FontSize="11" />
        </Button>
      </Grid>
    </Grid>
  </Border>
</Window>
