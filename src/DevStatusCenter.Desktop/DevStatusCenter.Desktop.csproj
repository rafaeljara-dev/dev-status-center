<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      TFM sin version de SDK a proposito. El sufijo 10.0.19041.0 activa las proyecciones WinRT y
      arrastra Microsoft.Windows.SDK.NET.dll: 24,9 MB, el 92% del ejecutable publicado, para una
      aplicacion que no llama a una sola API WinRT. SupportedOSPlatformVersion sigue declarando el
      minimo real de Windows sin pagar ese peso.
      Si algun dia se adoptan toasts con identidad MSIX (Windows.UI.Notifications), habra que
      volver al TFM versionado y asumir el tamano.
    -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>DevStatusCenter.Desktop</RootNamespace>
    <AssemblyName>DevStatusCenter</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <!--
      UseWindowsForms sustituye el conjunto de implicit usings del SDK por el suyo, que no
      incluye System.IO ni System.Net.Http y sí incluye System.Windows.Forms. Eso rompe
      Path/Directory y vuelve ambiguo MessageBox contra WPF. Se corrige aquí, una sola vez,
      en lugar de repetir usings en cada archivo.
    -->
    <Using Include="System.IO" />
    <Using Include="System.Windows.MessageBox" Alias="MessageBox" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DevStatusCenter.Domain/DevStatusCenter.Domain.csproj" />
    <ProjectReference Include="../DevStatusCenter.Application/DevStatusCenter.Application.csproj" />
    <ProjectReference Include="../DevStatusCenter.Infrastructure/DevStatusCenter.Infrastructure.csproj" />
    <ProjectReference Include="../DevStatusCenter.Providers.Mock/DevStatusCenter.Providers.Mock.csproj" />
    <ProjectReference Include="../DevStatusCenter.Providers.Neon/DevStatusCenter.Providers.Neon.csproj" />
  </ItemGroup>
</Project>
