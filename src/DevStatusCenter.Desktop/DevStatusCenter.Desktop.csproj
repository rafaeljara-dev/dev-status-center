<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>DevStatusCenter.Desktop</RootNamespace>
    <AssemblyName>DevStatusCenter</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <!--
      UseWindowsForms sustituye el conjunto de implicit usings del SDK por el suyo, que no
      incluye System.IO ni System.Net.Http y sí incluye System.Windows.Forms. Eso rompe
      Path/Directory y vuelve ambiguo MessageBox contra WPF. Se corrige aquí, una sola vez,
      en lugar de repetir usings en cada archivo.
    -->
    <Using Include="System.IO" />
    <Using Include="System.Windows.MessageBox" Alias="MessageBox" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DevStatusCenter.Domain/DevStatusCenter.Domain.csproj" />
    <ProjectReference Include="../DevStatusCenter.Application/DevStatusCenter.Application.csproj" />
    <ProjectReference Include="../DevStatusCenter.Infrastructure/DevStatusCenter.Infrastructure.csproj" />
    <ProjectReference Include="../DevStatusCenter.Providers.Mock/DevStatusCenter.Providers.Mock.csproj" />
  </ItemGroup>
</Project>
