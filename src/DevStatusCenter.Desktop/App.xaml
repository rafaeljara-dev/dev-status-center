<Application x:Class="DevStatusCenter.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DevStatusCenter.Desktop.Converters"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <conv:EqualityToVisibilityConverter x:Key="EqualityToVisibility" />
    <conv:EqualityToBrushConverter x:Key="TabForeground"
                                   MatchColor="#F5F7FA"
                                   FallbackColor="#7C8CA1" />
    <conv:EqualityToBrushConverter x:Key="TabUnderline"
                                   MatchColor="#62D99C"
                                   FallbackColor="#00000000" />
    <conv:NullToVisibilityConverter x:Key="NullToVisibility" />

    <!--
      Tipografia: se usan las que ya trae Windows 11 (Segoe UI Variable para texto, Cascadia Mono
      para cifras). Empotrar Space Grotesk + JetBrains Mono, que son las de los mockups, sumaria
      150-250 KB al ejecutable, casi un 10% de su tamano actual, y esto no es una marca publica.
    -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- Superficies. La opaca es el respaldo cuando el DWM no concede Acrylic (Windows 10). -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#11151D" />
    <SolidColorBrush x:Key="SurfaceGlassBrush" Color="#D00D1118" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#191F2A" />
    <SolidColorBrush x:Key="SurfaceSoftBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#2B3341" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="TextBrush" Color="#F5F7FA" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#99A4B5" />
    <SolidColorBrush x:Key="FaintTextBrush" Color="#6B7A90" />
    <SolidColorBrush x:Key="AccentBrush" Color="#62D99C" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F6C85F" />
    <SolidColorBrush x:Key="TrackBrush" Color="#17FFFFFF" />

    <!--
      Escala tipografica base. 13 px es el minimo comodo a 100% de escalado en una ventana que se
      lee de reojo; los mockups usaban 11 y en pantalla resultaban demasiado pequenos.
    -->
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <!-- Cifras en monoespaciada: al refrescar cambian de valor sin cambiar de ancho. -->
    <Style x:Key="Numeric" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="MonoLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource FaintTextBrush}" />
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,9" />
    </Style>

    <!--
      Los botones se redibujan enteros: la plantilla por defecto de WPF pinta un borde y un
      degradado claros que sobre el cristal se ven como un parche opaco.
    -->
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="{StaticResource SurfaceSoftBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="13,9" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    SnapsToDevicePixels="True">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#26FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#33FFFFFF" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      Campos de entrada. WPF los pinta con su tema claro por defecto, y como el estilo implicito
      de TextBlock de arriba fuerza texto casi blanco, todo lo que se dibuja con un TextBlock
      dentro de una plantilla ajena (los elementos de un ComboBox, los de un ListBox) salia
      blanco sobre blanco: invisible. Por eso las superficies de entrada se declaran aqui en vez
      de dejarlas al tema del sistema.
    -->
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
      <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="8,6" />
    </Style>

    <Style TargetType="ListBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    </Style>

    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Padding" Value="8,6" />
    </Style>

    <!--
      Las plantillas de fabrica de WPF resuelven el fondo de los desplegables y la seleccion por
      DynamicResource contra SystemColors, no contra el control. Redefinir esas claves aqui es lo
      unico que alcanza al popup del ComboBox sin reescribir su plantilla entera.
    -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#191F2A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#191F2A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F5F7FA" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F5F7FA" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2A3646" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F5F7FA" />

    <!-- Pestanas y filas: sin fondo, solo el subrayado o el realce al pasar por encima. -->
    <Style x:Key="FlatButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,4" />
    </Style>
  </Application.Resources>
</Application>
