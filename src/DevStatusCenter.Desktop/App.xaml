<Application x:Class="DevStatusCenter.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#11151D" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#191F2A" />
    <SolidColorBrush x:Key="BorderBrush" Color="#2B3341" />
    <SolidColorBrush x:Key="TextBrush" Color="#F5F7FA" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#99A4B5" />
    <SolidColorBrush x:Key="AccentBrush" Color="#62D99C" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F6C85F" />

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#242D3B" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,9" />
    </Style>
  </Application.Resources>
</Application>

