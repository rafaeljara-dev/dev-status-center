<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    El repo declara su propia fuente para que el restore no dependa del NuGet.Config
    de la máquina (el global de este equipo tiene <packageSources> vacío) y para que
    CI y local resuelvan exactamente lo mismo.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    Source mapping: con una sola fuente es redundante hoy, pero deja fijado que
    ningún paquete puede llegar de un feed añadido después sin tocar este archivo.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
