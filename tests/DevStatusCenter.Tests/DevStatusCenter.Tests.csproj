<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      TFM sin version de SDK a proposito. El sufijo 10.0.19041.0 activa las proyecciones WinRT y
      arrastra Microsoft.Windows.SDK.NET.dll: 24,9 MB, el 92% del ejecutable publicado, para una
      aplicacion que no llama a una sola API WinRT. SupportedOSPlatformVersion sigue declarando el
      minimo real de Windows sin pagar ese peso.
      Si algun dia se adoptan toasts con identidad MSIX (Windows.UI.Notifications), habra que
      volver al TFM versionado y asumir el tamano.
    -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!--
      CA1707 (sin guiones bajos en miembros) apunta a APIs públicas. En pruebas, el nombre
      Metodo_Escenario_Resultado es la convención y vale más que la regla. Se apaga solo aquí;
      el resto de la solución sigue con warnings-as-errors completo.
    -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/DevStatusCenter.Domain/DevStatusCenter.Domain.csproj" />
    <ProjectReference Include="../../src/DevStatusCenter.Application/DevStatusCenter.Application.csproj" />
    <ProjectReference Include="../../src/DevStatusCenter.Infrastructure/DevStatusCenter.Infrastructure.csproj" />
    <ProjectReference Include="../../src/DevStatusCenter.Providers.Mock/DevStatusCenter.Providers.Mock.csproj" />
    <ProjectReference Include="../../src/DevStatusCenter.Providers.Neon/DevStatusCenter.Providers.Neon.csproj" />
  </ItemGroup>
</Project>
