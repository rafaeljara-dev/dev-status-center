<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!--
      CA1707 (sin guiones bajos en miembros) apunta a APIs públicas. En pruebas, el nombre
      Metodo_Escenario_Resultado es la convención y vale más que la regla. Se apaga solo aquí;
      el resto de la solución sigue con warnings-as-errors completo.
    -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/DevStatusCenter.Domain/DevStatusCenter.Domain.csproj" />
    <ProjectReference Include="../../src/DevStatusCenter.Application/DevStatusCenter.Application.csproj" />
    <ProjectReference Include="../../src/DevStatusCenter.Infrastructure/DevStatusCenter.Infrastructure.csproj" />
    <ProjectReference Include="../../src/DevStatusCenter.Providers.Mock/DevStatusCenter.Providers.Mock.csproj" />
    <ProjectReference Include="../../src/DevStatusCenter.Providers.Neon/DevStatusCenter.Providers.Neon.csproj" />
  </ItemGroup>
</Project>
